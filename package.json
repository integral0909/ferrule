{
  "name": "ferrule-monorepo",
  "private": true,
  "description": "Ferrule: a telemetry pipeline with a typed transform language.",
  "license": "Apache-2.0",
  "author": "Fredrik Ahman <fredrik.fullstackdev@gmail.com>",
  "homepage": "https://github.com/integral0909/ferrule#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integral0909/ferrule.git"
  },
  "bugs": {
    "url": "https://github.com/integral0909/ferrule/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "tsc -b && node --experimental-strip-types scripts/generate-component-docs.ts",
    "docs:check": "tsc -b && node --experimental-strip-types scripts/generate-component-docs.ts --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
