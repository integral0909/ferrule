{
  "name": "@ferrule/sinks",
  "version": "0.1.0",
  "description": "Ferrule sinks: HTTP, console, file, object storage, ClickHouse, Postgres, Loki, and Kafka.",
  "license": "Apache-2.0",
  "author": "Fredrik Ahman <fredrik.fullstackdev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integral0909/ferrule.git",
    "directory": "packages/sinks"
  },
  "type": "module",
